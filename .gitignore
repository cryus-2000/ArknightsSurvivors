# Godot generated cache; keep .uid and .import sidecars tracked.
.godot/
/build/
/dist/
/node_modules/
**/node_modules/
.worktrees/
# Local third-party CLI checkout, not game source.
/tools/godot-mcp/
# Local backups and temporary files.
/art/backup_*/
*.tmp
*.log
.DS_Store
Thumbs.db
# Local configuration / credentials.
.env
.env.*
!.env.example
*.pem
*.key
.godot/export_credentials.cfg

# 收集来的藏品图标（疑似官方素材），只放本地参考，不入库
docs/reference/icons/

# 直接运行最新源码的启动器（build 里 exe 的副本，放在 game/ 下双击即可）
game/ShuiyueSurvivors_Latest.exe

build/*.bat

# EdgeOne deploy token (local only)
.edgeone_token

# 云端批跑：setup_linux.sh 生成的本机环境变量（含本机 Godot 路径），每台机器各自生成
tools/cloud/env.sh

# 第三方开放许可素材：只入库 README（各包许可不允许再分发）
art/third_party/*
!art/third_party/README.md

# Python
__pycache__/
