 "rules": [
  {
   "glob": "docs/**",
   "groups": [],
   "why": "文档不影响运行"
  },
  {
   "glob": "**/*.md",
   "groups": [],
   "why": "文档"
  },
  {
   "glob": "**/*.uid",
   "groups": [],
   "why": "uid"
  },
  {
   "glob": "**/*.import",
   "groups": [],
   "why": "导入缓存"
  },
  {
   "glob": "tools/check.py",
   "groups": [
    "core",
    "smoke-sample"
   ],
   "why": "改测试工具本身：核心契约 + 抽样冒烟；合入 CI 全量兜底"
  },
  {
   "glob": "tools/check_plan.py",
   "groups": [
    "core",
    "smoke-sample"
   ],
   "why": "同上"
  },
  {
   "glob": "tools/check_map.json",
   "groups": [
    "core",
    "smoke-sample"
   ],
   "why": "同上"
  },
  {
   "glob": "tools/godot_runner.py",
   "groups": [
    "core",
    "smoke-sample"
   ],
   "why": "同上"
  },
  {
   "glob": "tools/**",
   "groups": [],
   "why": "其余工具：静态项恒跑，不开 Godot（作为某静态项的脚本时它自己的项恒跑）"
  },
  {
   "glob": "game/tests/**",
   "groups": [
    "test-file"
   ],
   "why": "改测试文件：只跑引用该文件的项（代码内特殊处理）"
  },
  {
   "glob": "game/data/characters/*.json",
   "groups": [
    "op-tier"
   ],
   "why": "干员数据：该干员冒烟 / 成长节点 / 手动攻击 / 复现 + 含其名的场景",
   "ops": "stem"
  },
  {
   "glob": "game/scripts/characters/blocks/seg_*.gd",
   "groups": [
    "op-tier"
   ],
   "why": "单干员积木段",
   "ops": "seg"
  },
  {
   "glob": "game/scripts/characters/blocks/*.gd",
   "groups": [
    "core",
    "op_shared",
    "smoke-sample",
    "repro"
   ],
   "why": "积木基座（ob_* 等是单继承链）：影响全员，抽样冒烟 + 干员共用场景"
  },
  {
   "glob": "game/art/operators/**",
   "groups": [
    "op-tier"
   ],
   "why": "干员帧条",
   "ops": "art"
  },
  {
   "glob": "game/scripts/characters/*.gd",
   "groups": [
    "op-tier"
   ],
   "why": "干员脚本（共用文件已在 escalate 里升级）",
