        {"verb": "field", "center": "self", "r": "$s3_pull_r", "every": "$s3_pull_every", "dur": "$s3_pull_dur", "tick": [{"verb": "displace", "dir": "ring", "ring": "$s3_ring", "dist": 30}]},
        {"verb": "mode", "attack_mult": "$s3_open", "r_mult": "$s3_r_mult"},
        {"verb": "buff_self", "stat": "atk", "op": "mult", "value": "$s3_atk", "power": true},
        {"verb": "buff_self", "stat": "aspd", "op": "mult", "value": "$s3_aspd"},
        {"verb": "sb_mode", "snow_mult": "$s3_snow_mult"}]}
    ],
    "trait": [
      {"trig": "passive", "do": [{"verb": "sb_snow", "cell": "$cell", "r": "$snow_r", "cd0": "$snow_cd0", "cd1": "$snow_cd1", "cd2": "$snow_cd2", "max": "$snow_max",
