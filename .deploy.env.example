# 网页部署配置模板（tools/deploy_web.py，docs/33「网页部署」）。复制成仓库根目录的 .deploy.env 再填；.deploy.env 已在 .gitignore，不进 git。
# 环境变量优先于这个文件。AccessKey 用 RAM 子账号：只给下面两个 Bucket 的写权限 + CDN 刷新权限，不要用主账号。

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# OSS 地域，例如 cn-hangzhou / cn-shanghai / cn-shenzhen（用户定）
DEPLOY_REGION=

# 对外网页版：Bucket、对象前缀（可空 = 根目录）、CDN 加速域名（不带 https://）
DEPLOY_PUBLIC_BUCKET=
DEPLOY_PUBLIC_PREFIX=
DEPLOY_PUBLIC_DOMAIN=

# 对内网页版：必须用和对外不同的域名（网页存档按网站源隔离，同域名会共用存档）；Bucket 可以同一个，前缀要不同
DEPLOY_INTERNAL_BUCKET=
DEPLOY_INTERNAL_PREFIX=
DEPLOY_INTERNAL_DOMAIN=

# itch.io（tools/deploy_itch.py；只发对外版）：butler 密钥（https://itch.io/user/settings/api-keys）与目标 <用户名>/<游戏名>
BUTLER_API_KEY=
ITCH_TARGET=
