  "n1_zone": 1.15, "n2_dmg": 1.15, "echo_n": 3, "echo_delay": 0.2, "echo_mult": 0.5, "echo_max_n": 5, "res_mult": 0.3, "res_slow": 0.5,
  "orb_n": 4, "orb_speed": 0.9, "orb_hit": 18, "orb_kb": 100, "orb_cd": 0.5, "orb_mult": 0.2
 },
