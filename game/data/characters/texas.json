 "blocks": {
  "attack": {"shape": "dash_line", "aim": "nearest", "r": "$dash_len", "w": "$dash_w", "t": "$dash_t", "hold": "$dash_hold", "every": "$cd",
             "mult": 1.0, "src": "疾行斩", "tags": ["basic"], "fx": "fx_texas_dash"},
  "trait": [
   {"trig": "on_dash_end", "src": "疾行斩", "min_hits": 1, "do": [{"verb": "sp_secs", "seconds": "$hit_sp"}]},
   {"trig": "tick", "every": "$s3_every", "cond": "skill_active:2", "do": [
    {"shape": "dash_line", "aim": "densest", "r": "$dash_len", "w": "$dash_w", "t": "$dash_t", "hold": "$dash_hold", "mult": "$s3_mult", "power": true,
     "src": "剑雨滂沱", "tags": ["skill"], "fx": "fx_texas_dash", "sfx": "atk", "on_hit": [{"st": "stun", "dur": "$s3_stun"}]},
    {"verb": "sp_secs", "seconds": "$s3_sp"}]},
   {"trig": "on_skill_end", "skill": 2, "do": [
    {"shape": "circle", "center": "target", "r": "$s1_r", "mult": "$s3_end_mult", "power": true, "src": "剑雨", "tags": ["skill"]},
    {"verb": "fx_scatter", "strip": "fx_texas_blade", "n": "$rain_n", "r": "$s1_r", "center": "target"}]}
  ],
  "skills": [
   {"dur": 0, "do": [
    {"shape": "circle", "center": "self", "r": "$s1_r", "mult": "$s1_mult", "power": true, "src": "剑雨", "tags": ["skill"], "on_hit": [{"st": "stun", "dur": "$s1_stun"}]},
    {"verb": "sp_team", "pct": "$s1_sp"},
    {"verb": "fx_scatter", "strip": "fx_texas_blade", "n": "$rain_n", "r": "$s1_r", "center": "self"}]},
   {"dur": "permanent", "do": [
    {"verb": "dash_mod", "len_add": "$s2_len"},
    {"verb": "buff_self", "stat": "dmg", "op": "mult", "value": "$s2_mult"},
    {"verb": "buff_leader", "stat": "dash_cd", "op": "mult", "value": "1-$s2_dash_cd"}]},
   {"dur": "$s3_dur", "do": [
    {"verb": "mode", "no_attack": true}]}
  ],
  "talent": [
   {"trig": "on_leader_dash", "cd": "$talent_cd", "do": [
    {"shape": "dash_line", "aim": "leader_dir", "r": "$dash_len", "w": "$dash_w", "t": "$dash_t", "hold": "$dash_hold", "mult": 1.0,
     "src": "疾行斩", "tags": ["basic"], "fx": "fx_texas_dash", "sfx": "atk"},
    {"verb": "sp_secs", "seconds": "$talent_sp"}]},
   {"trig": "on_dash_end", "src": "疾行斩", "min_hits": "$talent_many", "do": [{"verb": "sp_secs", "seconds": "$talent_many_sp"}]}
  ],
  "progression": {
   "wide": {"verb": "dash_mod", "w_mult": "$n1_w"},
   "sharp": {"verb": "buff_self", "stat": "dmg", "op": "mult", "value": "$n2_mult"},
   "back": {"trig": "on_dash_end", "src": "疾行斩", "delay": "$back_delay", "do": [
    {"shape": "dash_line", "aim": "reverse", "r": "$dash_len", "w": "$dash_w", "t": "$dash_t", "mult": "$back_mult", "src": "回马剑", "tags": ["follow_up"], "fx": "fx_texas_dash"}]},
   "rain2": {"trig": "on_skill_start", "skill": 0, "delay": "$rain2_delay", "do": [
    {"shape": "circle", "center": "self", "r": "$s1_r", "mult": "$rain2_mult", "power": true, "src": "剑雨", "tags": ["skill"]},
    {"verb": "fx_scatter", "strip": "fx_texas_blade", "n": "$rain_n", "r": "$s1_r", "center": "self"}]},
   "elite2": {"trig": "on_dash_end", "do": [
    {"verb": "trail", "life": "$trail_life", "mult": "$trail_mult", "src": "余像", "tags": ["dot"], "on_hit": [{"st": "slow", "dur": "$trail_slow"}]}]}
  }
 }
