      {"vortex": {"r": 0.62, "max_r": 330, "n": 0, "acc_n": 0, "motes": 40, "mote_a": 0.7, "glow": 0.1, "glow_r": 0.22, "fill": 0.0, "spin": 0.5, "ring": 0.4}, "layer": "floor", "fade": 0.45, "if_tex": "fx_skalter_vortex_floor"}]},
    {"aura": "atk", "value": "$s3_atk", "scope": "squad", "power": true},
    {"verb": "heal", "pct": "$s3_heal", "every": 1.0, "power": true, "src": "浊心斯卡蒂"},
