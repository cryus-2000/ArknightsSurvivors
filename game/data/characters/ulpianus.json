 "attack": {
  "mode": "auto",
  "name": "锚击",
  "desc": "每 {$cd} 秒抡锚砸向身前，命中半径 {$reach} 内的全部敌人；砸地同时撼地，周围 {$quake_r} 内的敌人受到 {$quake_mult*100}% 伤害并被震退（撼地者）"
 },
 "skills": [
  {
   "name": "必须促成的接触",
   "en": "CONTACT MUST BE MADE",
   "sp": 6,
   "desc": "向最近的精英（没有则敌群最密处）掷出带锁链的锚，钩住至多 {$s1_pull_n} 名敌人拽到面前并眩晕 {$s1_stun} 秒，随即重砸身前 {$s1_r} 内 ×{$s1_mult} 伤害（钩中的精英额外 +{$s1_elite_mult*100-100}%）；钩不到人或钩住 Boss 时，锚直接砸在落点",
   "icon": "skill_ulpianus_s1"
  },
  {
   "name": "必须维系的界限",
   "en": "BOUNDARIES MUST BE KEPT",
   "sp": 15,
   "desc": "充能一次后永久生效：攻击 +{$s2_atk*100}%、锚击范围 +{$s2_reach*100-100}%，天赋层数上限 {$stack_cap} → {$stack_cap+$stack_cap_s2}",
   "permanent": true,
   "icon": "skill_ulpianus_s2"
  },
  {
   "name": "必须开辟的通路",
   "en": "PATHS MUST BE OPENED",
   "sp": 22,
   "dur": 8.0,
   "mode": "manual",
   "aim": "point",
   "desc": "掷锚：落点半径 {$s3_r} 内 ×{$s3_mult} 伤害并眩晕 {$s3_stun} 秒（精英减半、Boss {$s3_stun*$s3_stun_boss:1} 秒）；之后 {$s3_haste} 秒锚击间隔 -{(1-$haste_mult)*100}%。当队友时自动掷向敌群最密处；当队长时手动释放、自己选落点：鼠标指哪掷哪，键盘按住技能键蓄远、松手掷出，手柄右摇杆推多远掷多远，手机拖多远掷多远，最远 {$aim_range}。落点没有敌人也照掷",
   "icon": "skill_ulpianus_s3"
  }
 ],
 "talent": {
  "name": "血脉的哺养",
  "desc": "击杀精英 +1 层、Boss +{$stack_boss} 层，每层攻击 +{$stack_atk*100}%（上限 {$stack_cap} 层）；编队里其他深海猎人获得一半"
 },
