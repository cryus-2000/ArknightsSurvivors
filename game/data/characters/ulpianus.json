 "progression": [
  {
   "type": "custom",
   "id": "blast2",
   "name": "定点爆破",
   "icon": "growth_b_echo",
   "desc": "每次锚击 {$blast2_delay} 秒后同一落点再炸出第二道冲击环（半径 {$blast2_r}、锚击 {$blast2_mult*100}% 伤害）"
  },
  {
   "type": "custom",
   "id": "whirl",
   "name": "锁链回旋",
   "icon": "growth_u_area",
   "desc": "每第 3 次锚击，抡着锁链甩一整圈（半径 {$whirl_r}、锚击 {$whirl_mult*100}% 伤害）"
  },
  {
   "type": "elite",
   "level": 1,
   "name": "精英一",
   "desc": "解锁二技能「必须维系的界限」；解锁天赋「血脉的哺养」：击杀精英叠攻击，其他深海猎人得一半；普攻「收链」：锚击把落点外圈 {$reach*$pull_r:0} 内的敌人拉向落点 {$pull_dist}（精英减半，Boss 除外）",
   "attack": {
    "name": "收链",
    "desc": "锚击落点外圈（锚击范围之外、{$reach*$pull_r:0} 以内）的敌人被拉向落点 {$pull_dist}（精英减半，Boss 除外），下一锤就能砸到"
   }
  },
  {
   "type": "custom",
   "id": "drag",
   "name": "不容挣脱",
   "icon": "skill_ulpianus_s1",
   "desc": "「必须促成的接触」一次钩回的敌人 {$s1_pull_n} → {$s1_pull_n+$drag_n}、钩取范围扩大；锚砸中 Boss 时甩出锁链，把附近至多 {$drag_n} 名敌人拽到锚点（掷锚 {$drag_mult*100}% 伤害）"
  },
  {
   "type": "custom",
   "id": "rift",
   "name": "通路洞开",
   "icon": "skill_ulpianus_s3",
   "desc": "「必须促成的接触」锁链绷直时，从乌尔比安到锚点裂开一道通路，沿途敌人被掀飞 {$rift_air} 秒并受到锚击 {$rift_mult*100}% 伤害；精英二后「必须开辟的通路」掷锚时同样开路"
  },
  {
   "type": "elite",
   "level": 2,
   "name": "精英二",
   "desc": "解锁三技能「必须开辟的通路」（当队长时手动释放）：掷锚眩晕一片，之后 {$s3_haste} 秒锚击加速；撼地范围扩大到 {$quake_r_e2}、伤害提高到 {$quake_mult_e2*100}%；普攻质变「掷锚」：身上常亮血脉红纹；每第 {$throw_n} 次锚击改为把锚掷向 {$throw_min} 外最远的敌人（没有就掷向最近的），落地造成锚击 ×{$throw_mult} 伤害，随后顺锁链把沿线敌人拖回面前，再造成 {$throw_back*100}% 伤害（拖动 Boss 除外）",
   "attack": {
    "name": "掷锚",
    "desc": "每第 {$throw_n} 次锚击改为把锚掷向 {$throw_min} 外最远的敌人（没有就掷向最近的）：落地半径 {$throw_r} 造成锚击 ×{$throw_mult} 伤害，锁链绷直后把乌尔比安与锚之间宽 {$throw_w} 的一线敌人拖回面前，再造成 {$throw_back*100}% 伤害（拖动 Boss 除外）。锚在外面时不出锚击"
   }
  }
 ],
