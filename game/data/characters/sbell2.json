  "attack": {
    "mode": "auto",
    "name": "开阵",
    "desc": "特性「无垠的雪景」：身边地面每隔一段时间积一层雪（至多 {$snow_max} 层），敌人踏上立即受到攻击 {$snow_hit0*100}%（精一 {$snow_hit1*100}%、精二 {$snow_hit2*100}%）的法术伤害，并按层数减速，首个离开的敌人带走那格积雪。放出「霜涛覆岭」前不攻击，担任队长时防御与法术抗性大幅提升；之后每 {$cd} 秒对周围 {$open_r} 内的全部敌人造成法术伤害"
  },
  "skills": [
    {
      "name": "铃音吹雪",
      "en": "",
      "sp": 7,
      "icon": "skill_sbell2_s1",
      "desc": "朝敌群最密处吹出风雪：攻击 {$s1_mult*100}% 的法术伤害，寒冷 {$s1_cold} 秒并推开敌人，随后向前铺出 {$s1_lane_n} 格积雪（每格 +{$s1_lane_layers} 层）；一次吹两下"
    },
    {
      "name": "霜涛覆岭",
      "en": "",
      "sp": 16,
      "icon": "skill_sbell2_s2",
      "desc": "放出后永久开阵，攻击 {$s2_open*100}% 的群体法术伤害；满 5 层的积雪向四周扩散；积雪上的敌人每秒受到攻击 {$s2_dot*100}% 的法术伤害，离开积雪时寒冷 {$s2_leave_cold} 秒；积雪积满 5 层时冻结格上的敌人 {$s2_freeze} 秒",
      "permanent": true
    },
    {
      "name": "群山俯首",
      "en": "",
