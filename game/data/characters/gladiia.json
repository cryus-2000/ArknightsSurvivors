 "blocks": {
  "_doc": "歌蕾蒂娅（docs/123）：纯数据干员。普攻名义上是 circle，trait 用 every_n n:1 replace 把每一下换成 shape.hookshot（乌尔比安精二掷锚的积木，docs/61 §18.1）；路线「怒海」用 cond 切换三份钩索参数。拖拽到位的眩晕 / 冲撞用 every_n delay 对齐 taut + drag 的时刻。技能备注——S1：大洋裂断：重钩，拖回至多 2 名；S2：掌握怒海：伤害 ×1.5、间隔 ×1.3、射程 +40%；每次掷钩拉近身边敌人写在 trait（every_n 1 cond skill_active:1）；S3：碎漩狂舞：在最近一次钩中处（last_hit）留 8 秒漩涡；结束时聚拢 + 眩晕写在 trait（on_skill_end skill 2）",
  "attack": {
   "shape": "circle",
   "center": "front",
   "front": 0.7,
   "r": "$hook_r",
   "every": "$cd",
   "first": "$first_cd",
   "idle": "$idle_cd",
   "range": "$range",
   "src": "钩索",
   "ring": false,
   "_doc": "名义普攻（不会出手：trait 的 every_n n:1 replace 每一下都换成钩索）；range 决定索敌距离"
  },
  "skills": [
   {
    "dur": 0,
    "fx": [
     {
      "pfx": {
       "kind": "glow",
       "r": 26.0,
       "life": 0.3,
       "col": [
        0.3,
        0.5,
        0.78
       ],
       "alpha": 0.35
      },
      "at": "self",
      "off": [
       0,
       -20
      ]
     }
    ],
    "do": [
     {
      "shape": "hookshot",
      "range": "$s1_range",
      "min_d": 0,
      "r": "$s1_r",
      "basis": "atk",
      "mult": "$s1_mult",
      "back_mult": "$s1_back",
      "w": "$hook_w",
      "taut": "$hook_taut",
      "drag": "$hook_drag",
      "front": "$hook_front",
      "speed": "$hook_speed",
      "max_n": "$s1_n",
      "lock": true,
      "src": "大洋裂断",
      "back_src": "大洋裂断"
     }
    ]
   },
   {
    "dur": "$s2_dur",
    "status": "掌握怒海",
    "status_col": [
     0.3,
     0.5,
     0.78
    ],
    "fx": [
     {
      "banner": "掌握怒海"
     },
     {
      "gfx": {
       "kind": "rays",
       "life": 0.5,
       "col": [
        0.3,
        0.5,
        0.78
       ]
      },
      "at": "self",
      "off": [
       0,
       -20
      ]
     }
    ],
    "do": [
     {
      "verb": "mode",
      "dmg_mult": "$s2_dmg",
      "interval_mult": "$s2_interval",
      "power": true
     },
     {
      "verb": "buff_self",
      "stat": "op_range",
      "op": "add",
      "value": "$s2_range"
     }
    ]
   },
   {
    "dur": "$s3_dur",
    "status": "碎漩狂舞",
    "status_col": [
     0.35,
     0.6,
     0.9
    ],
    "fx": [
     {
      "banner": "碎漩狂舞"
     }
    ],
    "do": [
     {
      "verb": "field",
      "center": "last_hit",
      "r": "$s3_r",
      "dur": "$s3_dur",
      "every": "$s3_every",
      "cap": 1,
      "fx": [
       {
        "pfx": {
         "kind": "ring",
         "r": 1.0,
         "r0": 0.6,
         "life": 0.7,
         "col": [
          0.35,
          0.6,
          0.9
         ],
