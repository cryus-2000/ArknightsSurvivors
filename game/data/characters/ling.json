 "skills": [
  {
   "name": "重进酒",
   "en": "SIPS OF WINE",
   "sp": 8,
   "dur": 12.0,
   "icon": "skill_ling_s1",
   "desc": "召出「清平」：它在队长身边截住扑来的近战敌人（{$qp_decoy} 内的近战敌人改追它），扇形扑咬；{$s1_dur} 秒内令与龙的攻击 +{$s1_atk*100-100}%、攻击速度 +{$s1_aspd*100-100}%。技能结束或生命耗尽时清平散去"
  },
  {
   "name": "笑鸣瑟",
   "en": "AMIDST PLEASANT MELODIES",
   "sp": 10,
   "dur": 1.0,
   "icon": "skill_ling_s2",
   "desc": "召出「逍遥」随行队长身边，持续 {$xy_life} 秒，远程打击 {$xy_range} 内的敌人；随后令与每条逍遥各对 {$ming_n} 名敌人鸣瑟，造成攻击 {$ming_mult*100}% 的法术伤害并束缚 {$ming_bind} 秒（精英减半，Boss 除外）"
  },
  {
   "name": "宁作吾",
   "en": "TO REMAIN ONESELF",
   "sp": 24,
   "dur": 15.0,
   "icon": "skill_ling_s3",
   "desc": "召出「弦惊」，{$s3_dur} 秒内令与龙的攻击 +{$s3_atk*100-100}%，弦惊每 {$xj_aura_cd} 秒以剑气伤害周身敌人；场上已有别的龙时，弦惊将它们全部吞下，化为持剑的第二形态（重斩更宽、剑气范围 {$xj2_aura_r}）。技能结束时留下一条清平 {$split_life} 秒"
  }
 ],
 "talent": {
  "name": "随付笺咏醉屠苏",
  "desc": "龙散去（到时、被击倒、被吞下或被顶替）时，令其余技能各充能 {$drink_sp} 秒，并得到 1 层酒意：攻击 +{$drink_atk*100}%，至多 {$drink_cap} 层，{$drink_dur} 秒内没有新的酒意则全部散去"
 },
