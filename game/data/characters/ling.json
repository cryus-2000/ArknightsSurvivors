 "attack": {
  "mode": "auto",
  "name": "挑灯",
  "desc": "每 {$grow_cd0} 秒在身边化出一条当前调的龙（同时至多 {$cap0} 条，满员时最早一条别的调的龙换成当前调）；普攻随调变化：清平调「墨击」身边半径 {$hit_r} 扇形，逍遥调「墨弹」{$bolt_range} 内最近的敌人（Boss 优先），弦惊调「剑痕」穿透一线（长 {$edge_len}）。开局为逍遥调，放哪个技能就转为哪个调"
 },
 "skills": [
  {
   "name": "重进酒",
   "en": "SIPS OF WINE",
   "sp": 8,
   "dur": 12.0,
   "icon": "skill_ling_s1",
   "desc": "转为清平调：立刻化出一条清平，之后化出的龙都是清平；普攻变为墨击；{$s1_dur} 秒内清平截住扑向队长的近战敌人（{$qp_decoy} 内的近战敌人改追清平），令与龙的攻击 +{$s1_atk*100-100}%、攻击速度 +{$s1_aspd*100-100}%"
  },
  {
   "name": "笑鸣瑟",
   "en": "AMIDST PLEASANT MELODIES",
   "sp": 10,
   "dur": 1.0,
   "icon": "skill_ling_s2",
   "desc": "转为逍遥调：立刻化出一条逍遥，之后化出的龙都是逍遥（随行队长，远程打击 {$xy_range} 内的敌人）；普攻变为墨弹；令与场上每条逍遥各对 {$ming_n} 名敌人鸣瑟，造成攻击 {$ming_mult*100}% 的法术伤害并束缚 {$ming_bind} 秒（精英减半，Boss 除外）"
  },
  {
   "name": "宁作吾",
   "en": "TO REMAIN ONESELF",
   "sp": 24,
   "dur": 15.0,
   "icon": "skill_ling_s3",
   "desc": "转为弦惊调：普攻变为剑痕；弦惊吞下场上全部的龙，化为持剑的第二形态 {$s3_dur} 秒（宽扇形重斩，每 {$xj_aura_cd} 秒以剑气伤害半径 {$xj2_aura_r} 内的敌人），期间令与龙的攻击 +{$s3_atk*100-100}%、不再化龙；结束时散成 {$split_n} 条弦惊"
  }
 ],
