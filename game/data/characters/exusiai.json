  "attack": {"shape": "projectile", "every": "$cd", "range": "$range", "speed": "$bullet_speed", "shots": "$shots", "spread_deg": "$spread_deg", "elite_prio": "$elite_prio", "focus_boss": true, "pierce": "$pierce", "kb": "$kb",
