 "progression": [
  {"type": "custom", "id": "twin", "name": "双枪", "icon": "growth_b_count", "desc": "每次射击的子弹数 +{$twin_shots}"},
  {"type": "custom", "id": "power", "name": "高压弹", "icon": "growth_b_size", "desc": "她的伤害 ×{$n2_mult}"},
  {"type": "elite", "level": 1, "name": "精英一", "desc": "解锁二技能「扫射模式」；解锁天赋「快速弹匣」：击杀攒满弹匣后倾泻 {$mag_shots} 发；普攻「穿甲连射」：连续命中同一名敌人时每发伤害 +{$e1_per*100}%（最多 +{$e1_per*$e1_max*100}%），{$e1_decay} 秒未命中该敌人则清零",
   "attack": {"name": "穿甲连射", "desc": "速射连续命中同一名敌人时每发伤害 +{$e1_per*100}%（最多 +{$e1_per*$e1_max*100}%），子弹由白转金，叠满时命中迸出金色火花；{$e1_decay} 秒未命中该敌人则清零"}},
  {"type": "custom", "id": "range", "name": "延长弹道", "icon": "growth_b_range", "desc": "射程 +{$n1_range*100}%"},
  {"type": "custom", "id": "ricochet", "name": "跳弹", "icon": "growth_b_echo", "desc": "子弹命中后有 {$ricochet_chance*100}% 概率跳向 {$ricochet_r} 内另一名敌人（伤害 {$ricochet_mult*100}%）"},
  {"type": "elite", "level": 2, "name": "精英二", "desc": "解锁三技能「过载模式」；普攻质变「天使的祝福」：编队中另外两名干员头顶浮现光环，攻击速度 +{$e2_aspd*100}%；弹匣上限 {$mag_cap} → {$e2_mag_cap}",
   "attack": {"name": "天使的祝福", "desc": "编队中另外两名干员头顶浮现金色光环：攻击速度 +{$e2_aspd*100}%，每次攻击带一道金色闪光；她开火时光环随之一亮。弹匣上限 {$mag_cap} → {$e2_mag_cap}"}}
 ],
 "gallery": {"demo_mate": {"op": "texas", "elite": 2}, "tags": ["远程", "连射", "子弹数", "弹匣"], "desc": "狙击干员，持双枪连射，每秒可达三发。每次射击的子弹数随成长增加；弹匣随击杀增长（每次 +1，照亮范围内击杀 +{$mag_lit_bonus}），攒满后倾泻一轮扇形射击"},
