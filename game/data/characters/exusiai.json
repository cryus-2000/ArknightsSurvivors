   "elite2": [
    {"trig": "passive", "_doc": "天使的祝福（docs/91 §2）：另外两名干员攻速 +15%，头顶金色光环（她开火时一亮）", "do": [
     {"aura": "aspd", "value": "$e2_aspd", "scope": "others",
