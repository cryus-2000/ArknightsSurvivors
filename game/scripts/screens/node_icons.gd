## 以 c 为中心画一枚图标，每格 px 像素（取整，保持像素边缘）；shadow：右下错一格的暗影
static func draw(ci: CanvasItem, kind: String, c: Vector2, px: float, col: Color, shadow := true) -> void:
	var rows: Array = PIX.get(kind, PIX.incident)
	var p: float = maxf(1.0, roundf(px))
	var o: Vector2 = (c - Vector2(8.0, 8.0) * p).round()
	for pass_i in (2 if shadow else 1):
		var cc: Color = Color(0.0, 0.0, 0.0, col.a * 0.55) if (shadow and pass_i == 0) else col
		var off: Vector2 = Vector2(p, p) if (shadow and pass_i == 0) else Vector2.ZERO
		for y in rows.size():
			var row: String = rows[y]
			var x := 0
			while x < row.length():
				if row[x] != "#":
					x += 1
					continue
				var x1 := x
				while x1 < row.length() and row[x1] == "#":
					x1 += 1
				ci.draw_rect(Rect2(o + off + Vector2(x * p, y * p), Vector2((x1 - x) * p, p)), cc)
				x = x1
