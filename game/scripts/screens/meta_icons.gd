	"disp4": [".....#.....", "....#.#....", "...#...#...", "..#..#..#..", ".#..#.#..#.", ".#.#...#.#.", "#..#...#..#", "#...#.#...#", ".#...#...#.", "..#.....#..", "...#####..."],
	"cell": ["...#####...", "..#.....#..", ".#..#....#.", "#..###....#", "#...#..#..#", "#.....###.#", "#..#...#..#", "#.###.....#", ".#.#.....#.", "..#.....#..", "...#####..."],
}

static var _tex := {}


## 图标贴图（白色，调用方 modulate 上色）；没有的键回落到前缀
static func tex(key: String) -> ImageTexture:
	if not ICONS.has(key):
		key = key.rstrip("0123456789")
	if not ICONS.has(key):
		key = "cell"
	if _tex.has(key):
		return _tex[key]
	var im := Image.create(11, 11, false, Image.FORMAT_RGBA8)
	var rows: Array = ICONS[key]
	for y in 11:
		for x in 11:
			if str(rows[y])[x] == "#":
				im.set_pixel(x, y, Color.WHITE)
	var t := ImageTexture.create_from_image(im)
	_tex[key] = t
	return t
