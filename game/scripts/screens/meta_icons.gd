	"def": ["###########", "#.........#", "#....#....#", "#....#....#", "#..#####..#", "#....#....#", ".#...#...#.", ".#.......#.", "..#.....#..", "...#...#...", ".....#....."],
	"reg": ["#.#.#.#.#.#", "###########", ".#.......#.", ".#..###..#.", ".#..#.#..#.", ".#..###..#.", ".#.......#.", ".#...#...#.", ".#..###..#.", "###########", "###########"],
	"sh": ["...#####...", "..#.....#..", ".#...#...#.", "#....#....#", "#....#....#", "#....#....#", "#.........#", "#....#....#", ".#.......#.", "..#.....#..", "...#####..."],
	"xp": [".....#.....", "....###....", "...#####...", "..#..#..#..", ".#...#...#.", "#....#....#", ".#.......#.", "..#.....#..", "...#...#...", "....#.#....", ".....#....."],
	"pick": ["...#####...", "..#.....#..", ".#..###..#.", "#..#...#..#", "#.#..#..#.#", "#.#.###.#.#", "#.#..#..#.#", "#..#...#..#", ".#..###..#.", "..#.....#..", "...#####..."],
	"gold": [".....#.....", "....#.#....", "....#.#....", "...#...#...", "...#.#.#...", "..#.###.#..", "..#..#..#..", ".#.......#.", ".#.......#.", "#.........#", "###########"],
	"shop": ["....#####..", "...#....##.", "..#....#.#.", ".######..#.", ".#....#..#.", ".#....#..#.", ".#....#.#..", ".#....##...", ".######....", "...........", "..........."],
	"disp1": ["###########", ".#.......#.", "..#.....#..", "...#.#.#...", "....#.#....", ".....#.....", "....#.#....", "...#...#...", "..#.###.#..", ".#.#####.#.", "###########"],
	"disp2": ["...#####...", "..#..#..#..", ".#..###..#.", "#..#...#..#", "#.#.....#.#", "##.......##", "#.#.....#.#", "#..#...#..#", ".#..###..#.", "..#..#..#..", "...#####..."],
