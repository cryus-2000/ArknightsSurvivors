    "onboard": "res://data/onboard.json",
    "lore": "res://data/lore.json",
    "medals": "res://data/medals.json",
    "medals_layout": "res://data/medals_layout.json",
    "doctor": "res://data/doctor.json",
    "enemy_pixels": "res://data/enemy_pixels.json",
    "enemy_redraw": "res://data/enemy_redraw.json",
